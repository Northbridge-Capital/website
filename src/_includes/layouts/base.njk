{% set desc = description or site.description %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
{%- if noindex %}
<meta name="robots" content="noindex">
{%- else %}
<meta name="description" content="{{ desc }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ desc }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/assets/img/og-image.png">
<meta name="twitter:card" content="summary_large_image">
{%- endif %}
<meta name="theme-color" content="#0B0B0B">
<link rel="icon" href="/assets/img/icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
<script>document.documentElement.classList.add("js")</script>
<link rel="preload" href="/assets/fonts/hanken-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/styles.css?v={{ cssBundle.hash }}">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

{% include "partials/header.njk" %}
{{ content | safe }}
{% include "partials/footer.njk" %}
<script src="/assets/js/site.js?v={{ jsHash }}" defer></script>
</body>
</html>
