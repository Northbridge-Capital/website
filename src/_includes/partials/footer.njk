<footer class="band s-foot">
  <div class="wrap g12 foot">
    <div class="c c-1-7 word"><span class="ln b-085">{{ site.name.split(" ")[0] }}</span><span class="ln b-056">{{ site.name.split(" ")[1] }}</span></div>
    <ul class="c c-7-13 social" aria-label="Elsewhere">
      {%- for l in links %}
      <li><a href="{{ l.href }}">{% include "icons/social-" + l.icon + ".svg" %}<span>{{ l.name }}</span></a></li>
      {%- endfor %}
    </ul>
    <div class="c c-full legal xs">© {{ year }} {{ site.name }}. All rights reserved. {{ site.legal }}</div>
  </div>
</footer>
